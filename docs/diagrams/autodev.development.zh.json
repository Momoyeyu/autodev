        "to": "impact"
      },
      {
        "from": "impact",
        "to": "tests"
      },
      {
        "from": "tests",
        "to": "review"
      },
      {
        "from": "review",
        "to": "tests"
      },
      {
        "from": "review",
        "to": "baseline"
      },
      {
        "from": "baseline",
        "to": "implement"
      },
      {
        "from": "implement",
        "to": "verify"
      },
      {
        "from": "verify",
        "to": "implement"
      },
      {
        "from": "verify",
        "to": "table"
      }
    ],
    "requiredPaths": [
      {
        "from": "input",
        "to": "table"
      }
    ]
  }
